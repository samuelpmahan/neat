#!/usr/bin/env python3
"""tidy v0 — milestones. Declares rungs, verifies frozen hashes.

Promote is Sam-gated: it refuses without --by-sam carrying his words.
Before a real baseline exists, versions are theater — declare with
--version pre-baseline and verify reports "nothing to verify".

The gate: tidy "clean" means every spec-bound neat item's m-cases have
evidence (receipts that the Part x Calculation composed correctly at the
boundary). `tidy verify` runs the gate; `tidy promote` reports it as
advisory — Sam's pen is never refused by the gate.
"""
import argparse
import datetime
import re
import subprocess
import sys
from pathlib import Path

LEDGER = Path(__file__).resolve().parent / "TIDY.md"
NEAT_LEDGER = Path(__file__).resolve().parent / "NEAT.md"
STATUSES = ["proposed", "open", "baselined", "released"]


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%MZ")


def git(repo, *args):
    r = subprocess.run(["git", "-C", str(repo)] + list(args),
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"git failed: {r.stderr.strip()}")
    return r.stdout.strip()


def split_ms(text, ms_id):
    lines = text.splitlines(keepends=True)
    hdr = next((i for i, l in enumerate(lines) if l.rstrip("\n") == f"## Milestone: {ms_id}"), None)
    if hdr is None:
        return None
    end = next((i for i in range(hdr + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
    return lines[:hdr], lines[hdr:end], lines[end:]


def join(parts):
    pre, item, post = parts
    return "".join(pre + item + post)


def logline(item_lines, entry):
    hdr = next(i for i, l in enumerate(item_lines) if l.rstrip("\n") == "- log:")
    j = hdr + 1
    while j < len(item_lines) and item_lines[j].startswith("  - "):
        j += 1
    item_lines.insert(j, f"  - {now()} {entry}\n")


def cmd_declare(a):
    LEDGER.touch(exist_ok=True)
    text = LEDGER.read_text()
    if split_ms(text, a.id):
        sys.exit(f"milestone {a.id} already declared")
    clean, tree = "—", "—"
    if a.clean:
        repo = a.repo or "."
        clean = git(repo, "rev-parse", "--verify", f"{a.clean}^{{commit}}")
        tree = git(repo, "rev-parse", f"{clean}^{{tree}}")
    block = (
        f"## Milestone: {a.id}\n"
        f"- version: {a.version or 'pre-baseline'}\n"
        f"- status: open\n"
        f"- clean: {clean}\n"
        f"- hash: {tree}\n"
        f"- declared: {now()}\n"
        f"- log:\n"
        f"  - {now()} declared {a.note or ''}".rstrip() + "\n"
    )
    if text and not text.endswith("\n"):
        text += "\n"
    LEDGER.write_text(text + ("\n" if text else "") + block)
    print(f"milestone {a.id} declared (clean={clean[:8] if clean != '—' else '—'})")


def gate(ms_id):
    """The integration gate: every spec-bound item's m-cases evidenced.

    Returns (ok, lines). Unbound items are outside the gate, not failures.
    """
    text = NEAT_LEDGER.read_text() if NEAT_LEDGER.is_file() else ""
    report, bound = [], 0
    total_cases, total_evidenced = 0, 0
    ok = True
    for m in re.finditer(r"^## Item: (\S+)\s*$", text, re.M):
        iid = m.group(1)
        lines = text.splitlines(keepends=True)
        hdr = next(i for i, l in enumerate(lines) if l.rstrip("\n") == f"## Item: {iid}")
        end = next((i for i in range(hdr + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
        blk = lines[hdr:end]
        ms = next((l.split(":", 1)[1].strip() for l in blk if l.startswith("- milestone:")), "")
        if ms != ms_id:
            continue
        spec = next((l.split(":", 1)[1].strip() for l in blk if l.startswith("- spec:")), "—")
        if not spec or spec == "—":
            report.append(f"  {iid}: unbound (outside the gate)")
            continue
        bound += 1
        case_ids = []
        for l in blk:
            if l.startswith("  - ["):
                rest = l[3:].strip()
                for st in ("[open] ", "[ready] "):
                    if rest.startswith(st):
                        rest = rest[len(st):]
                        break
                case_ids.append(rest.split(" — ", 1)[0].strip())
        evidenced = set()
        in_ev = False
        for l in blk:
            if l.rstrip("\n") == "- evidence:":
                in_ev = True
                continue
            if in_ev:
                if l.startswith("  - "):
                    evidenced.add(l[4:].split(":", 1)[0].strip())
                else:
                    in_ev = False
        missing = [c for c in case_ids if c not in evidenced]
        total_cases += len(case_ids)
        total_evidenced += len(case_ids) - len(missing)
        if missing:
            ok = False
            report.append(f"  {iid}: {len(case_ids) - len(missing)}/{len(case_ids)} evidenced; "
                          f"missing: {', '.join(missing)}")
        else:
            report.append(f"  {iid}: {len(case_ids)}/{len(case_ids)} evidenced — PASS")
    if bound == 0:
        return True, ["  no spec-bound items — nothing to check (not a failure)"]
    report.append(f"  gate: {total_evidenced}/{total_cases} cases evidenced "
                  f"across {bound} bound item(s)")
    return ok, report


def cmd_verify(a):
    parts = split_ms(LEDGER.read_text(), a.id)
    if not parts:
        sys.exit(f"no such milestone: {a.id}")
    clean = next(l.split(":", 1)[1].strip() for l in parts[1] if l.startswith("- clean:"))
    frozen = next(l.split(":", 1)[1].strip() for l in parts[1] if l.startswith("- hash:"))
    baseline_ok = True
    if clean in ("—", "", "none"):
        print(f"{a.id}: no baseline recorded — nothing to verify (not a failure)")
    else:
        repo = a.repo or "."
        cur = git(repo, "rev-parse", f"{clean}^{{tree}}")
        if cur == frozen:
            print(f"{a.id}: PASS clean tree still matches frozen hash {frozen[:12]}")
        else:
            print(f"{a.id}: FAIL clean tree moved ({frozen[:12]} -> {cur[:12]})")
            baseline_ok = False
    g_ok, g_lines = gate(a.id)
    print("gate (correct composition):")
    for l in g_lines:
        print(l)
    if not (baseline_ok and g_ok):
        sys.exit(1)
    print("verify: PASS")


def cmd_promote(a):
    if not a.by_sam:
        sys.exit("refused: promote is Sam-gated. Re-run with --by-sam carrying his words.")
    parts = split_ms(LEDGER.read_text(), a.id)
    if not parts:
        sys.exit(f"no such milestone: {a.id}")
    g_ok, g_lines = gate(a.id)
    print("gate (correct composition) — advisory; Sam's pen decides:")
    for l in g_lines:
        print(l)
    if not g_ok:
        print("(gate red — proceeding on Sam's words anyway)")
    repo = a.repo or "."
    new_clean = git(repo, "rev-parse", "--verify", f"{a.clean}^{{commit}}")
    new_tree = git(repo, "rev-parse", f"{new_clean}^{{tree}}")
    old = next(l.split(":", 1)[1].strip() for l in parts[1] if l.startswith("- clean:"))
    for i, l in enumerate(parts[1]):
        if l.startswith("- clean:"):
            parts[1][i] = f"- clean: {new_clean}\n"
        elif l.startswith("- hash:"):
            parts[1][i] = f"- hash: {new_tree}\n"
    logline(parts[1], f"promote {old[:8] if old not in ('—','') else '—'} -> {new_clean[:8]} by-sam: {a.by_sam}")
    LEDGER.write_text(join(parts))
    print(f"{a.id} promoted to {new_clean[:8]}")


def cmd_status(a):
    if a.to not in STATUSES:
        sys.exit(f"want one of {', '.join(STATUSES)}")
    parts = split_ms(LEDGER.read_text(), a.id)
    if not parts:
        sys.exit(f"no such milestone: {a.id}")
    for i, l in enumerate(parts[1]):
        if l.startswith("- status:"):
            parts[1][i] = f"- status: {a.to}\n"
            break
    logline(parts[1], f"status -> {a.to}")
    LEDGER.write_text(join(parts))
    print(f"{a.id} -> {a.to}")


def cmd_show(a):
    parts = split_ms(LEDGER.read_text(), a.id)
    if not parts:
        sys.exit(f"no such milestone: {a.id}")
    print("".join(parts[1]).rstrip("\n"))


def main():
    p = argparse.ArgumentParser(prog="tidy", description="tidy v0 — milestones")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("declare", help="name and freeze a rung")
    s.add_argument("id")
    s.add_argument("--version", default=None)
    s.add_argument("--clean", default=None, help="git rev to freeze as the clean tree")
    s.add_argument("--repo", default=None)
    s.add_argument("--note", default="")

    s = sub.add_parser("verify", help="rehash clean tree; pass/fail")
    s.add_argument("id")
    s.add_argument("--repo", default=None)

    s = sub.add_parser("promote", help="advance the clean tree (Sam-gated)")
    s.add_argument("id")
    s.add_argument("--clean", required=True)
    s.add_argument("--repo", default=None)
    s.add_argument("--by-sam", default=None, help="Sam's words authorizing the promote")

    s = sub.add_parser("status", help=f"set status ({', '.join(STATUSES)})")
    s.add_argument("id")
    s.add_argument("to")

    s = sub.add_parser("show", help="dump one milestone")
    s.add_argument("id")

    a = p.parse_args()
    {"declare": cmd_declare, "verify": cmd_verify, "promote": cmd_promote,
     "status": cmd_status, "show": cmd_show}[a.cmd](a)


if __name__ == "__main__":
    main()
