      }
    },
    {
      "id": "DS-02",
      "title": "Disc framing / correction",
      "target": { "kind": "tick", "identity": "tick.discstudio.disc-framing", "composition": "discstudio.first-flow", "name": "tick.discstudio.disc-framing" },
      "inspectableResult": "That outline follows my disc; the corrected preview looks right.",
      "targetScope": "goldilocks",
      "scopes": {
        "minimal": { "requirementIds": ["circle-position"] },
        "goldilocks": { "requirementIds": ["ellipse-handles", "corrected-preview", "reset-original"] },
        "maximal": { "requirementIds": ["rim-detection", "perspective-correction", "confidence-recapture"] }
      }
    },
    {
      "id": "DS-03",
      "title": "Prepared image",
      "target": { "kind": "tick", "identity": "tick.discstudio.prepared-image", "composition": "discstudio.first-flow", "name": "tick.discstudio.prepared-image" },
