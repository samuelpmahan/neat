    },
    {
      "id": "DS-04",
      "title": "Shelf insertion",
      "target": { "kind": "tick", "identity": "tick.discstudio.shelf-insertion", "composition": "discstudio.first-flow", "name": "tick.discstudio.shelf-insertion" },
      "inspectableResult": "That physical disc is saved, survives reload, and is reusable.",
      "targetScope": "goldilocks",
      "scopes": {
        "minimal": { "requirementIds": ["save-tile"] },
        "goldilocks": { "requirementIds": ["edit-remove", "nickname", "reload-reuse"] },
